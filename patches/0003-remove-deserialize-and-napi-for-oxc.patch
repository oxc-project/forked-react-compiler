-fn visit_program(prog: &mut react_compiler_ast::Program, si: &ScopeInfo) {
-    for stmt in &mut prog.body {
-        visit_stmt(stmt, si);
-    }
-}
-
-fn visit_block(block: &mut BlockStatement, si: &ScopeInfo) {
-    for stmt in &mut block.body {
