-// --- Format a single log item as comparable string ---
-function formatLogItem(item: LogItem): string {
-  if (item.kind === 'entry') {
-    return `## ${item.name}\n${item.value}`;
-  } else {
-    return `[${item.eventKind}]${item.fnName ? ' ' + item.fnName : ''}: ${item.detail}`;
